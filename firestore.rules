rules_version = '2';

service cloud.firestore {
  // Keep this list in sync with ALLOWED_EMAILS in src/lib/allowedEmails.ts.
  // Only these accounts may read/write any data at all.
  function isAllowedEmail() {
    return request.auth.token.email in ['alazcano94@gmail.com'];
  }

  match /databases/{database}/documents {
    // Each signed-in, allowed user can only read/write their own document.
    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isAllowedEmail();
    }
  }
}
